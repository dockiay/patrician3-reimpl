# Figuras de la batalla del asedio por tierra que faltaban en el enlazador (prueba ui_asedio_tierra, 22/11): con la vista del
# asedio abierta en la ciudad que se ve, los métodos de las figuras devolvían 0 y nadie se movía ni combatía.
0x5623b0	variant_walker_init (ballestero: alta +0x40)
0x5624c0	variant_walker_update (ballestero: paso)
0x570f70	siege_fighter_init (piquero: alta)
0x5710a0	siege_fighter_update (piquero: paso)
0x5740f0	siege_cart_spawn (ariete: alta)
0x5743a0	siege_cart_update (ariete: paso)
0x5758e0	lane_walker_get_sprite_set (ariete: conjunto)
0x577fb0	siege_fighter_walker_acquire_target_and_step (luchador: objetivo y paso)
